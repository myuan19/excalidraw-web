{
  "name": "editorhub-desktop",
  "productName": "EditorHub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "start:server": "node src/main.mjs",
    "sync-icon": "node scripts/sync-app-icon.mjs",
    "prepack": "node scripts/sync-app-icon.mjs",
    "predist": "node scripts/sync-app-icon.mjs",
    "pack": "electron-builder --dir",
    "pack:debug": "electron-builder --dir --config electron-builder.debug.cjs",
    "dist": "electron-builder --win nsis portable",
    "dist:debug": "electron-builder --win nsis portable --config electron-builder.debug.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "rotating-file-stream": "^3.2.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "42.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.editorhub.desktop",
    "productName": "EditorHub",
    "icon": "build/icon.ico",
    "directories": {
      "output": "../../dist/desktop"
    },
    "asar": true,
    "files": [
      "electron/**",
      "src/**",
      "adapters/**",
      "build/**",
      ".runtime/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/web/build",
        "to": "apps/web/build"
      },
      {
        "from": "build/icon.png",
        "to": "icons/app-icon.png"
      },
      {
        "from": "../../public/maskable_icon_x512.png",
        "to": "icons/maskable_icon_x512.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Excalidraw Drawing",
        "description": "EditorHub Excalidraw document",
        "role": "Editor",
        "mimeType": "application/vnd.excalidraw+json"
      },
      {
        "ext": "smm",
        "name": "Simple Mind Map",
        "description": "EditorHub mind map document",
        "role": "Editor",
        "mimeType": "application/vnd.simple-mind-map+json"
      },
      {
        "ext": "excalidrawlib",
        "name": "Excalidraw Library",
        "description": "EditorHub Excalidraw library",
        "role": "Editor",
        "mimeType": "application/vnd.excalidrawlib+json"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "protocols": [
      {
        "name": "EditorHub",
        "schemes": ["editorhub"]
      }
    ]
  }
}
