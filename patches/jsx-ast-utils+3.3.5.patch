+/**
+ * Extractor for MetaProperty (e.g. import.meta, new.target).
+ * Represent as dotted id so MemberExpression chaining resolves (import.meta.env.*).
+ */
+export default function extractValueFromMetaProperty(value) {
+  const metaName = value.meta && value.meta.name;
+  const propName = value.property && value.property.name;
+  if (metaName && propName) {
+    return `${metaName}.${propName}`;
+  }
+  return "MetaProperty";
+}
