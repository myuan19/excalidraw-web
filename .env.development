MODE="development"

# Stubs for upstream `@excalidraw/excalidraw` (library link, analytics, etc.)
VITE_APP_ENABLE_TRACKING=false
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries
VITE_APP_WS_SERVER_URL=
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=
VITE_APP_PORTAL_URL=
VITE_APP_AI_BACKEND=
VITE_APP_FIREBASE_CONFIG={}
VITE_APP_PLUS_LP=https://excalidraw.com
VITE_APP_PLUS_APP=https://excalidraw.com
VITE_APP_DISABLE_SENTRY=true
VITE_APP_MATOMO_URL=
VITE_APP_CDN_MATOMO_TRACKER_URL=
VITE_APP_MATOMO_SITE_ID=
VITE_WORKER_ID=

# Dev server port
VITE_APP_PORT=3001

# Enable PWA in dev (usually false)
VITE_APP_ENABLE_PWA=false

# Vite dev proxy: `/api` → local Express (_server). Default http://127.0.0.1:3033
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3033

# Optional: public base path for API (same-origin default)
# VITE_APP_API_BASE=

# whether to disable live reload / HMR (e.g. when debugging Service Workers)
VITE_APP_DEV_DISABLE_LIVE_RELOAD=

FAST_REFRESH=false

# Set this flag to false if you want to open the overlay by default
VITE_APP_COLLAPSE_OVERLAY=true

# Set this flag to false to disable eslint in dev
VITE_APP_ENABLE_ESLINT=true

# set to true in .env.development.local to disable the prevent unload dialog
VITE_APP_DISABLE_PREVENT_UNLOAD=

# Debug flags
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=
