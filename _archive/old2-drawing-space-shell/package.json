{
  "private": true,
  "name": "drawing-space-shell",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"yarn dev:server\" \"yarn dev:app\"",
    "dev:app": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:typecheck": "tsc -b"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "^9.2.1",
    "cors": "2.8.5",
    "express": "4.21.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@iconify/tailwind4": "1.2.3",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "node-gyp": "^12.3.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2"
  }
}
